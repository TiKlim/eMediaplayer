<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Mediaplayer2.ViewModels"
             xmlns:views="clr-namespace:Mediaplayer2.Views"
             mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="759"
             x:DataType="vm:MainPageViewModel"
             x:Class="Mediaplayer2.Views.MainPageView">
    <!-- 
    Copyright (c) 2026 Timofeev Klim (eMediaplayer)
    This program is free software: you can redistribute it and/or modify
    it under the terms of the GNU General Public License as published by
    the Free Software Foundation, either version 3 of the License.
    -->
    
    <!-- DataContext -->
    <UserControl.DataContext>
        <vm:MainPageViewModel/>
    </UserControl.DataContext>
    <!-- DataContext -->
    <!-- Основной Grid -->
    <Grid ShowGridLines="False"
          RowDefinitions="Auto, Auto, *, Auto, Auto"
          Background="{DynamicResource ThirdColor}">
        <!-- Полоса прокрутки -->
        <StackPanel Grid.Row="4"
                   Height="50"
                   Background="{DynamicResource SecondaryColor}">
            <Slider Name="PlaybackSlider"
                    Minimum="0"
                    
                    Margin="10,0,10,0"
                    Background="Black"
                    Foreground="{DynamicResource PrimaryColor}">
            </Slider>
            <!--Maximum="{Binding AudioDuration.TotalSeconds}"
                    Value="{Binding CurrentTime.TotalSeconds, Mode=TwoWay}"-->
        </StackPanel>
        <!-- Полоса прокрутки -->
        <!-- Нижняя панель -->
        <Grid Grid.Row="3"
              Height="80"
              ColumnDefinitions="Auto, Auto, Auto, Auto, *, Auto, Auto, Auto"
              ShowGridLines="False">
            <!-- Кнопка "Назад на 10 секунд" -->
            <Border Grid.Column="0"
                    Width="66"
                    Margin="10 10 0 10"
                    Background="{DynamicResource SecondaryColor}"
                    CornerRadius="4">
                <Button Name="BackwardButton"
                        Classes="LeftPanel"
                        Command="{Binding BackTime}"
                        CornerRadius="4"
                        Background="{DynamicResource PrimaryColor}"
                        HorizontalAlignment="Center">
                    <Image Source="{DynamicResource BackTenButton}"
                           Height="40"/>
                </Button>
            </Border>
            <!-- Кнопка "Назад на 10 секунд" -->
            <!-- Кнопка "Играть/стоп" -->
            <Border Grid.Column="1"
                    Width="66"
                    Margin="10 10 0 10"
                    Background="{DynamicResource SecondaryColor}"
                    CornerRadius="4">
                <Button Name="PlayButton"
                        Classes="LeftPanel"
                        Command="{Binding PlayPauseCommand}"
                        CornerRadius="4"
                        Background="{DynamicResource PrimaryColor}"
                        HorizontalAlignment="Center">
                    <StackPanel>
                        <Image Source="{DynamicResource PlayButton}"
                               IsVisible="{Binding Play}"
                               Height="40"/>
                        <Image Source="{DynamicResource StopButton}"
                               IsVisible="{Binding Stop}"
                               Height="40"/>
                    </StackPanel>
                </Button>
            </Border>
            <!-- Кнопка "Играть/стоп" -->
            <!-- Кнопка "Вперёд на 10 секунд" -->
            <Border Grid.Column="2"
                    Width="66"
                    Margin="10 10 0 10"
                    Background="{DynamicResource SecondaryColor}"
                    CornerRadius="4">
                <Button Name="ForwardButton"
                        Classes="LeftPanel"
                        Command="{Binding ForeTime}"
                        CornerRadius="4"
                        Background="{DynamicResource PrimaryColor}"
                        HorizontalAlignment="Center">
                    <Image Source="{DynamicResource ForeTenButton}"
                           Height="40"/>
                </Button>
            </Border>
            <!-- Кнопка "Вперёд на 10 секунд" -->
            <!-- Панель эквалайзера -->
            <Border Grid.Column="3"
                    Width="220"
                    Margin="12 10 0 10"
                    Background="{DynamicResource SecondaryColor}"
                    CornerRadius="4">
                <Button Name="EqualizerButton"
                        Width="200"
                        Height="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="10"
                        Classes="LeftPanel"
                        Command="{Binding OpenEqualizerMenuCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                        Background="{DynamicResource FourthColor}"
                        CornerRadius="4">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="{Binding Pop}" Command="{Binding SelectPresetCommand}" CommandParameter="Pop" />
                            <MenuItem Header="{Binding Vocal}" Command="{Binding SelectPresetCommand}" CommandParameter="Vocal" />
                            <MenuItem Header="{Binding Rock}" Command="{Binding SelectPresetCommand}" CommandParameter="Rock" />
                            <MenuItem Header="{Binding Jazz}" Command="{Binding SelectPresetCommand}" CommandParameter="Jazz" />
                            <MenuItem Header="{Binding Classical}" Command="{Binding SelectPresetCommand}" CommandParameter="Classical" />
                            <MenuItem Header="{Binding Bass}" Command="{Binding SelectPresetCommand}" CommandParameter="Bass Boost" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Border>
            <!-- Панель эквалайзера -->
            <!-- Панель таймера -->
            <Border Grid.Column="4"
                    Margin="10 10 0 10"
                    Background="{DynamicResource SecondaryColor}"
                    CornerRadius="4">
                
            </Border>
            <!-- Панель таймера -->
            <!-- Панель регулирования скорости -->
            <Border Grid.Column="5"
                    Width="220"
                    Margin="10 10 0 10"
                    Background="{DynamicResource SecondaryColor}"
                    CornerRadius="4">
                <ComboBox ItemsSource="{Binding Presets}" 
                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" 
                          Width="200"
                          Height="40"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Margin="10"
                          Background="{DynamicResource FourthColor}"
                          BorderBrush="{DynamicResource SecondaryColor}"
                          CornerRadius="4">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text=""/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Border>
            <!-- Панель регулирования скорости -->
            <!-- Панель регулирования громкости (Кнопка) -->
            <Border Grid.Column="6"
                    Width="66"
                    Margin="10 10 0 10"
                    Background="{DynamicResource SecondaryColor}"
                    CornerRadius="4">
                
            </Border>
            <!-- Панель регулирования громкости (Кнопка) -->
            <!-- Панель регулирования громкости (Ползунок) -->
            <Border Grid.Column="7"
                    Width="144"
                    Margin="10 10 10 10"
                    Background="{DynamicResource SecondaryColor}"
                    CornerRadius="4">
                
            </Border>
            <!-- Панель регулирования громкости (Ползунок) -->
        </Grid>
        <!-- Нижняя панель -->
        <!-- Средняя панель -->
        <Border Grid.Row="2"
                Background="{DynamicResource SecondaryColor}"
                Margin="40"
                Width="400"
                IsVisible="False">
            
        </Border>
        <Image Grid.Row="2" 
               Source="{DynamicResource MainBack}"
               Opacity="0.2"
               Margin="40"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               IsVisible="True"/>
        <!-- Средняя панель -->
        <!-- Верхняя панель -->
        <Grid Grid.Row="1"
              Height="80"
              ColumnDefinitions="Auto, Auto, *, Auto, Auto"
              ShowGridLines="False">
            <!-- Смена темы -->
            <Border Grid.Column="0"
                    Width="220"
                    Margin="10 10 0 10"
                    Background="{DynamicResource SecondaryColor}"
                    CornerRadius="4">
                <ComboBox ItemsSource="{Binding Presets}" 
                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" 
                          Width="200"
                          Height="40"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Margin="10"
                          Background="{DynamicResource FourthColor}"
                          BorderBrush="{DynamicResource SecondaryColor}"
                          CornerRadius="4">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Border>
            <!-- Смена темы -->
            <!-- Смена языка -->
            <Border Grid.Column="1"
                    Width="220"
                    Margin="10 10 0 10"
                    Background="{DynamicResource SecondaryColor}"
                    CornerRadius="4">
                <ComboBox ItemsSource="{Binding Languages}" 
                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" 
                          Width="200"
                          Height="40"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Margin="10"
                          Background="{DynamicResource FourthColor}"
                          BorderBrush="{DynamicResource SecondaryColor}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding LanguageName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Border>
            <!-- Смена языка -->
            <!-- Панель информации о файле -->
            <Border Grid.Column="2"
                    Margin="10 10 0 10"
                    Background="{DynamicResource SecondaryColor}"
                    CornerRadius="4">
                
            </Border>
            <!-- Панель информации о файле -->
            <!-- Кнопка поиска файла -->
            <Border Grid.Column="3"
                    Width="220"
                    Margin="10 10 0 10"
                    Background="{DynamicResource SecondaryColor}"
                    CornerRadius="4">
                <Button Width="200"
                        Height="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="10"
                        Background="{DynamicResource PrimaryColor}"
                        BorderBrush="{DynamicResource SecondaryColor}"
                        CornerRadius="4">
                    <TextBlock Text="{DynamicResource FindFileButton}"
                               FontSize="15"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"></TextBlock>
                </Button>
            </Border>
            <!-- Кнопка поиска файла -->
            <!-- Кнопка перехода к редактированию -->
            <Border Grid.Column="4"
                    Width="220"
                    Margin="10 10 10 10"
                    Background="{DynamicResource SecondaryColor}"
                    CornerRadius="4">
                <Button Width="200"
                        Height="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="10"
                        Background="{DynamicResource PrimaryColor}"
                        BorderBrush="{DynamicResource SecondaryColor}"
                        CornerRadius="4">
                    <TextBlock Text="{DynamicResource EditFileButton}"
                               FontSize="15"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"></TextBlock>
                </Button>
            </Border>
            <!-- Кнопка перехода к редактированию -->
        </Grid>
        <!-- Верхняя панель -->
        <!-- Панель управления окном -->
        <StackPanel Grid.Row="0"
                    Height="50"></StackPanel>
        <!-- Панель управления окном -->
    </Grid>
    <!-- Основной Grid -->
</UserControl>
