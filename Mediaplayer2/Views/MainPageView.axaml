<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Mediaplayer2.ViewModels"
             xmlns:views="clr-namespace:Mediaplayer2.Views"
             mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="759"
             x:DataType="vm:MainPageViewModel"
             x:Class="Mediaplayer2.Views.MainPageView">
    <!-- DataContext -->
    <UserControl.DataContext>
        <vm:MainPageViewModel/>
    </UserControl.DataContext>
    <!-- DataContext -->
    <!-- Основной Grid -->
    <Grid ShowGridLines="False"
          RowDefinitions="Auto, Auto, *, Auto, Auto"
          Background="{DynamicResource ThirdColor}">
        <!-- Полоса прокрутки -->
        <StackPanel Grid.Row="4"
                   Height="50"
                   Background="{DynamicResource SecondaryColor}">
            <Slider Name="PlaybackSlider"
                    Minimum="0"
                    
                    Margin="10,0,10,0"
                    Background="Black"
                    Foreground="{DynamicResource PrimaryColor}">
            </Slider>
            <!--Maximum="{Binding AudioDuration.TotalSeconds}"
                    Value="{Binding CurrentTime.TotalSeconds, Mode=TwoWay}"-->
        </StackPanel>
        <!-- Полоса прокрутки -->
        <!-- Нижняя панель -->
        <Grid Grid.Row="3"
              Height="80"
              ColumnDefinitions="Auto, Auto, *, Auto, Auto"
              ShowGridLines="False">
            <!-- Панель управления воспроизведением -->
            <StackPanel Grid.Column="0"
                        Width="220"
                        Margin="10 10 0 10"
                        Background="{DynamicResource SecondaryColor}">
                <!--Кнопка "Назад на 10 секунд"-->
                <Button Name="BackwardButton"
                        HorizontalAlignment="Stretch"
                        Classes="LeftPanel"
                        Command="{Binding BackTime}">
                    <Image Source="{DynamicResource BackTenButton}"
                           MaxWidth="50" 
                           MinWidth="20"/>
                </Button>
                <!--Кнопка "Играть/стоп"-->
                <Button Name="PlayButton"
                        HorizontalAlignment="Stretch"
                        Classes="LeftPanel"
                        Command="{Binding PlayPauseCommand}">
                    <StackPanel>
                        <Image Source="{DynamicResource PlayButton}"
                               IsVisible="{Binding Play}"
                               Width="35"
                               MaxWidth="50" 
                               MinWidth="20"/>
                        <Image Source="{DynamicResource StopButton}"
                               IsVisible="{Binding Stop}"
                               Width="35"
                               MaxWidth="50" 
                               MinWidth="20"/>
                    </StackPanel>
                </Button>
                <!--Кнопка "Вперёд на 10 секунд"-->
                <Button Name="ForwardButton"
                        HorizontalAlignment="Stretch"
                        Classes="LeftPanel"
                        Command="{Binding ForeTime}">
                    <Image Source="{DynamicResource ForeTenButton}"
                           MaxWidth="50" 
                           MinWidth="20"/>
                </Button>
            </StackPanel>
            <!-- Панель управления воспроизведением -->
            <!-- Панель регулирования скорости -->
            <StackPanel Grid.Column="1"
                        Width="220"
                        Margin="10 10 0 10"
                        Background="{DynamicResource SecondaryColor}">
                
            </StackPanel>
            <!-- Панель регулирования скорости -->
            <!-- Панель таймера -->
            <StackPanel Grid.Column="2"
                        Margin="10 10 0 10"
                        Background="{DynamicResource SecondaryColor}">
                
            </StackPanel>
            <!-- Панель таймера -->
            <!-- Панель эквалайзера -->
            <StackPanel Grid.Column="3"
                        Width="220"
                        Margin="10 10 0 10"
                        Background="{DynamicResource SecondaryColor}">
                
            </StackPanel>
            <!-- Панель эквалайзера -->
            <!-- Панель регулирования громкости -->
            <StackPanel Grid.Column="4"
                        Width="220"
                        Margin="10 10 10 10"
                        Background="{DynamicResource SecondaryColor}">
                
            </StackPanel>
            <!-- Панель регулирования громкости -->
        </Grid>
        <!-- Нижняя панель -->
        <!-- Средняя панель -->
        <!-- Средняя панель -->
        <!-- Верхняя панель -->
        <Grid Grid.Row="1"
              Height="80"
              ColumnDefinitions="Auto, Auto, *, Auto, Auto"
              ShowGridLines="False">
            <!-- Смена темы -->
            <StackPanel Grid.Column="0"
                        Width="220"
                        Margin="10 10 0 10"
                        Background="{DynamicResource SecondaryColor}">
                <ComboBox ItemsSource="{Binding Presets}" 
                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" 
                          Width="200"
                          Height="40"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Margin="10"
                          Background="{DynamicResource PrimaryColor}"
                          BorderBrush="{DynamicResource SecondaryColor}"
                          Classes="ComboBox"
                          Foreground="White">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <!-- Смена темы -->
            <!-- Смена языка -->
            <StackPanel Grid.Column="1"
                        Width="220"
                        Margin="10 10 0 10"
                        Background="{DynamicResource SecondaryColor}">
                <ComboBox ItemsSource="{Binding Languages}" 
                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" 
                          Width="200"
                          Height="40"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Margin="10"
                          Background="{DynamicResource PrimaryColor}"
                          BorderBrush="{DynamicResource SecondaryColor}"
                          Classes="ComboBox"
                          Foreground="White">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding LanguageName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <!-- Смена языка -->
            <!-- Панель информации о файле -->
            <StackPanel Grid.Column="2"
                        Margin="10 10 0 10"
                        Background="{DynamicResource SecondaryColor}">
                
            </StackPanel>
            <!-- Панель информации о файле -->
            <!-- Кнопка поиска файла -->
            <StackPanel Grid.Column="3"
                        Width="220"
                        Margin="10 10 0 10"
                        Background="{DynamicResource SecondaryColor}">
                <Button Width="200"
                        Height="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="10"
                        Background="{DynamicResource PrimaryColor}"
                        BorderBrush="{DynamicResource SecondaryColor}">
                    <TextBlock Text="{DynamicResource FindFileButton}"
                               FontSize="15"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"></TextBlock>
                </Button>
            </StackPanel>
            <!-- Кнопка поиска файла -->
            <!-- Кнопка перехода к редактированию -->
            <StackPanel Grid.Column="4"
                        Width="220"
                        Margin="10 10 10 10"
                        Background="{DynamicResource SecondaryColor}">
                <Button Width="200"
                        Height="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="10"
                        Background="{DynamicResource PrimaryColor}"
                        BorderBrush="{DynamicResource SecondaryColor}">
                    <TextBlock Text="{DynamicResource EditFileButton}"
                               FontSize="15"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"></TextBlock>
                </Button>
            </StackPanel>
            <!-- Кнопка перехода к редактированию -->
        </Grid>
        <!-- Верхняя панель -->
        <!-- Панель управления окном -->
        <StackPanel Grid.Row="0"
                    Height="50"></StackPanel>
        <!-- Панель управления окном -->
    </Grid>
    <!-- Основной Grid -->
</UserControl>
